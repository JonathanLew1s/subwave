# Dev-only image for the Next.js web UI.
# Installs node_modules at build time so the bind-mounted source doesn't
# shadow them — same pattern as Dockerfile.controller in dev compose.
# SITE_URL and NEXT_PUBLIC_GA_ID are not needed: static metadata routes
# are skipped in dev and analytics are omitted.
FROM node:22-bookworm-slim
WORKDIR /app
COPY web/package.json web/package-lock.json ./
RUN npm ci
# Source is bind-mounted by docker-compose.dev.yml — no COPY needed.
CMD ["npm", "run", "dev"]
