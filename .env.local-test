# Local test environment — MA backend smoke test
# Copy to .env before running: cp .env.local-test .env

ADMIN_USER=admin
ADMIN_PASS=subwave

# Needed by prod compose to exit cleanly
SITE_URL=http://localhost:7700

# Music Assistant backend
LIBRARY_BACKEND=music-assistant
# MA_URL points to the homelab via kubectl port-forward (run separately):
#   KUBECONFIG=~/code/talos/kubeconfig kubectl port-forward -n music-assistant svc/music-assistant-ui 8095:8095
MA_URL=http://host.docker.internal:8095
MA_MUSIC_ROOT=/music
# Path inside the container where we'll mount the library.db snapshot
MA_DB_PATH=/var/sub-wave/ma/library.db

TZ=Europe/London
